<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="access_rights_rollout_wizard_view_form" model="ir.ui.view">
        <field name="name">access.rights.rollout.wizard.view.form</field>
        <field name="model">access.rights.rollout.wizard</field>
        <field name="arch" type="xml">
            <form string="Roll Out Access Profiles">
                <div class="alert alert-info" role="alert">
                    <b><field name="uncovered_total" class="oe_inline"/> internal user(s)</b>
                    currently have no access profile at all — they run on raw group
                    permissions with no restrictions applied.
                    <button name="action_view_uncovered" type="object"
                            class="btn btn-link p-0 align-baseline"
                            string="See who they are"/>
                </div>

                <group>
                    <field name="mode" widget="radio" options="{'horizontal': True}"/>
                </group>

                <group invisible="mode != 'template'">
                    <field name="template" widget="radio"/>
                    <div colspan="2" class="text-muted ps-4">
                        <field name="template_hint" nolabel="1" readonly="1"/>
                    </div>
                </group>

                <group invisible="mode != 'existing'">
                    <field name="profile_id" options="{'no_create': True}"
                           required="mode == 'existing'"/>
                </group>

                <group string="Who To Cover">
                    <field name="cover_all_uncovered"/>
                    <field name="department_ids" widget="many2many_tags"
                           options="{'no_create': True}"
                           placeholder="e.g. Accounting, Warehouse, Production"
                           invisible="cover_all_uncovered"/>
                    <field name="include_children" invisible="cover_all_uncovered"/>
                    <field name="extra_user_ids" widget="many2many_tags"
                           options="{'no_create': True}"/>
                    <field name="skip_covered"/>
                    <field name="skip_admins"/>
                </group>

                <group string="Preview">
                    <field name="preview_count"/>
                    <field name="preview_text" nolabel="1" colspan="2" readonly="1"/>
                </group>

                <div class="alert alert-warning" role="alert"
                     invisible="mode != 'template'">
                    One profile is created per department (e.g.
                    <i>Accounting — Standard Staff</i>) so each department can be
                    refined on its own afterwards. Templates only set the safe
                    baseline switches — the actual business rights still come from
                    each user's Odoo groups, so nobody loses access to their work.
                </div>

                <footer>
                    <button name="action_apply" type="object" string="Roll Out"
                            class="btn-primary" invisible="preview_count == 0"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_access_rights_rollout_wizard" model="ir.actions.act_window">
        <field name="name">Roll Out Profiles</field>
        <field name="res_model">access.rights.rollout.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="groups_id" eval="[(4, ref('group_access_rights_manager'))]"/>
    </record>

    <menuitem id="menu_access_rights_rollout"
              name="Roll Out Profiles"
              parent="menu_access_rights_root"
              action="action_access_rights_rollout_wizard"
              sequence="15"/>

</odoo>
