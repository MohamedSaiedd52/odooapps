<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============ Unusual Logins ============ -->
    <record id="access_rights_anomaly_view_tree" model="ir.ui.view">
        <field name="name">access.rights.anomaly.view.tree</field>
        <field name="model">access.rights.anomaly</field>
        <field name="arch" type="xml">
            <list create="false" edit="false"
                  decoration-danger="severity == 'high' and state == 'new'"
                  decoration-warning="severity == 'warning' and state == 'new'"
                  decoration-muted="state != 'new'">
                <field name="occurred_at" string="When"/>
                <field name="user_id"/>
                <field name="kind" widget="badge"/>
                <field name="detail"/>
                <field name="ip_address"/>
                <field name="device_id" optional="show"/>
                <field name="severity" widget="badge"
                       decoration-danger="severity == 'high'"
                       decoration-warning="severity == 'warning'"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'reviewed'"
                       decoration-info="state == 'acted'"/>
                <field name="reviewed_by" optional="hide"/>
                <button name="action_mark_reviewed" type="object"
                        string="Mark OK" icon="fa-check"
                        invisible="state != 'new'"/>
                <button name="action_block_device" type="object"
                        string="Block Device" icon="fa-ban"
                        invisible="not device_id"
                        confirm="Block this device and end the user's sessions?"/>
                <button name="action_end_sessions" type="object"
                        string="End Sessions" icon="fa-sign-out"
                        confirm="Terminate this user's open sessions?"/>
            </list>
        </field>
    </record>

    <record id="access_rights_anomaly_view_form" model="ir.ui.view">
        <field name="name">access.rights.anomaly.view.form</field>
        <field name="model">access.rights.anomaly</field>
        <field name="arch" type="xml">
            <form string="Unusual Login" create="false">
                <header>
                    <button name="action_mark_reviewed" type="object"
                            string="Mark as OK" class="btn-primary"
                            invisible="state != 'new'"/>
                    <button name="action_block_device" type="object"
                            string="Block Device" class="btn-danger"
                            invisible="not device_id"
                            confirm="Block this device and end the user's sessions?"/>
                    <button name="action_end_sessions" type="object"
                            string="End Sessions"
                            confirm="Terminate this user's open sessions?"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="kind" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="user_id" readonly="1"/>
                            <field name="occurred_at" readonly="1"/>
                            <field name="severity" readonly="1"/>
                        </group>
                        <group>
                            <field name="ip_address" readonly="1"/>
                            <field name="device_id" readonly="1"/>
                            <field name="log_id" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <field name="detail" readonly="1"/>
                        <field name="review_note" placeholder="Why is this OK / what did you do?"/>
                        <field name="reviewed_by" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="access_rights_anomaly_view_search" model="ir.ui.view">
        <field name="name">access.rights.anomaly.view.search</field>
        <field name="model">access.rights.anomaly</field>
        <field name="arch" type="xml">
            <search string="Unusual Logins">
                <field name="user_id"/>
                <field name="ip_address"/>
                <field name="detail"/>
                <filter string="Needs Review" name="new" domain="[('state', '=', 'new')]"/>
                <filter string="High Severity" name="high" domain="[('severity', '=', 'high')]"/>
                <separator/>
                <filter string="New Device" name="k_device" domain="[('kind', '=', 'new_device')]"/>
                <filter string="New IP" name="k_ip" domain="[('kind', '=', 'new_ip')]"/>
                <filter string="Unusual Hour" name="k_hour" domain="[('kind', '=', 'odd_hour')]"/>
                <filter string="Failed Bursts" name="k_failed" domain="[('kind', '=', 'failed_burst')]"/>
                <filter string="Two Networks" name="k_parallel" domain="[('kind', '=', 'parallel_network')]"/>
                <separator/>
                <filter string="Last 7 Days" name="last_week"
                        domain="[('occurred_at', '&gt;=', 'today -7d')]"/>
                <group name="group_by">
                    <filter string="User" name="g_user" context="{'group_by': 'user_id'}"/>
                    <filter string="Type" name="g_kind" context="{'group_by': 'kind'}"/>
                    <filter string="Status" name="g_state" context="{'group_by': 'state'}"/>
                    <filter string="Day" name="g_day" context="{'group_by': 'occurred_at:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_arm_anomalies" model="ir.actions.act_window">
        <field name="name">Unusual Logins</field>
        <field name="res_model">access.rights.anomaly</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_new': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Nothing unusual so far</p>
            <p>
                Every successful login is scored against the user's own history:
                a device or IP never seen before, a login outside working hours,
                a burst of failed attempts, or the same account active from two
                networks at once. Serious findings also notify the access-rights
                managers.
            </p>
            <p>
                Tune it with the system parameters
                <code>access_rights_management.work_hours</code> (default
                <code>7-19</code>),
                <code>access_rights_management.anomaly_detection</code> and
                <code>access_rights_management.anomaly_notify</code>
                (set to <code>off</code> to disable).
            </p>
        </field>
    </record>

    <!-- ============ Permission Change Timeline ============ -->
    <record id="access_rights_change_view_tree" model="ir.ui.view">
        <field name="name">access.rights.change.view.tree</field>
        <field name="model">access.rights.change</field>
        <field name="arch" type="xml">
            <list create="false" edit="false"
                  decoration-danger="is_admin_change and action == 'granted'"
                  decoration-success="action == 'granted' and not is_admin_change"
                  decoration-muted="action == 'revoked'">
                <field name="create_date" string="When"/>
                <field name="user_id"/>
                <field name="action" widget="badge"
                       decoration-success="action == 'granted'"
                       decoration-warning="action == 'revoked'"/>
                <field name="change_type" widget="badge"/>
                <field name="item_name" string="Permission"/>
                <field name="is_admin_change" optional="show"/>
                <field name="actor_id" string="Changed By"/>
                <button name="action_open_user" type="object"
                        string="Open User" icon="fa-user"/>
            </list>
        </field>
    </record>

    <record id="access_rights_change_view_search" model="ir.ui.view">
        <field name="name">access.rights.change.view.search</field>
        <field name="model">access.rights.change</field>
        <field name="arch" type="xml">
            <search string="Permission Changes">
                <field name="user_id"/>
                <field name="item_name" string="Permission"/>
                <field name="actor_id" string="Changed By"/>
                <filter string="Granted" name="granted" domain="[('action', '=', 'granted')]"/>
                <filter string="Revoked" name="revoked" domain="[('action', '=', 'revoked')]"/>
                <separator/>
                <filter string="Administrator Rights" name="admin"
                        domain="[('is_admin_change', '=', True)]"/>
                <filter string="Groups" name="t_group" domain="[('change_type', '=', 'group')]"/>
                <filter string="Profiles" name="t_profile" domain="[('change_type', '=', 'profile')]"/>
                <separator/>
                <filter string="Last 7 Days" name="last_week"
                        domain="[('create_date', '&gt;=', 'today -7d')]"/>
                <filter string="Last 30 Days" name="last_month"
                        domain="[('create_date', '&gt;=', 'today -30d')]"/>
                <group name="group_by">
                    <filter string="User" name="g_user" context="{'group_by': 'user_id'}"/>
                    <filter string="Changed By" name="g_actor" context="{'group_by': 'actor_id'}"/>
                    <filter string="Action" name="g_action" context="{'group_by': 'action'}"/>
                    <filter string="Day" name="g_day" context="{'group_by': 'create_date:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_arm_changes" model="ir.actions.act_window">
        <field name="name">Permission Changes</field>
        <field name="res_model">access.rights.change</field>
        <field name="view_mode">list</field>
        <field name="context">{'search_default_last_month': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No permission change recorded yet</p>
            <p>
                Every security group and access profile granted to or revoked from
                a user is recorded here with who did it and when — the answer to
                "who gave this person this access?". Grants of full-administrator
                rights are highlighted.
            </p>
        </field>
    </record>

    <!-- ============ Menus ============ -->
    <menuitem id="menu_arm_anomalies"
              name="Unusual Logins"
              parent="menu_access_rights_security"
              action="action_arm_anomalies"
              sequence="5"/>

    <menuitem id="menu_arm_changes"
              name="Permission Changes"
              parent="menu_access_rights_security"
              action="action_arm_changes"
              sequence="25"/>

</odoo>
