<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_line_tree_inherit_currency_sum" model="ir.ui.view">
        <field name="name">account.move.line.tree.currency.sum</field>
        <field name="model">account.move.line</field>
        <field name="inherit_id" ref="account.view_move_line_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='amount_currency']" position="attributes">
                <attribute name="sum">Total USD</attribute>
            </xpath>
        </field>
    </record>
</odoo>