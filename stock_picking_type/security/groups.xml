<odoo>
    <data>


        <record id="stock.group_stock_manager" model="res.groups">
            <field name="name">Administrator</field>
            <field name="category_id" ref="base.module_category_inventory_inventory"/>
            <field name="implied_ids"
                   eval="[(4, ref('stock.group_stock_user'))]"/>
            <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>



        <record id="record_rule_stock_picking_type_manager" model="ir.rule">
            <field name="name">Allow Stock Managers to Access All Picking Types</field>
            <field name="model_id" ref="model_stock_picking_type"/>
            <field name="groups"
                   eval="[(4, ref('stock.group_stock_manager'))]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="1"/>
        </record>
        <record id="record_rule_stock_picking_type_restrict" model="ir.rule">
            <field name="name">Restrict Picking Types by Assigned Types</field>
            <field name="model_id" ref="model_stock_picking_type"/>
            <field name="domain_force">[('id', 'in', user.picking_type_ids.ids)]</field>
            <field name="groups" eval="[(4, ref('stock.group_stock_user'))]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="0"/>
            <field name="perm_create" eval="0"/>
            <field name="perm_unlink" eval="0"/>
        </record>


    </data>
</odoo>