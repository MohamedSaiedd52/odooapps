<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="demo_rule_so" model="irio.approval.rule">
        <field name="name">Sales Orders above 1,000</field>
        <field name="model_apply">sale.order</field>
        <field name="min_amount">1000</field>
        <field name="max_amount">0</field>
        <field name="level_ids" eval="[
            (0, 0, {'sequence': 1, 'name': 'Sales Manager',
                    'user_ids': [(6, 0, [ref('base.user_demo')])],
                    'min_approvals': 1, 'escalate_days': 3}),
            (0, 0, {'sequence': 2, 'name': 'General Manager',
                    'user_ids': [(6, 0, [ref('base.user_admin')])],
                    'min_approvals': 1, 'escalate_days': 2}),
        ]"/>
    </record>

    <record id="demo_rule_po" model="irio.approval.rule">
        <field name="name">Purchase Orders above 500</field>
        <field name="model_apply">purchase.order</field>
        <field name="min_amount">500</field>
        <field name="max_amount">0</field>
        <field name="level_ids" eval="[
            (0, 0, {'sequence': 1, 'name': 'Purchase Manager',
                    'user_ids': [(6, 0, [ref('base.user_admin')])],
                    'min_approvals': 1, 'escalate_days': 3}),
        ]"/>
    </record>
</odoo>
