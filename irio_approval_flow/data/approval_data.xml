<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="seq_approval_request" model="ir.sequence">
        <field name="name">Approval Request</field>
        <field name="code">irio.approval.request</field>
        <field name="prefix">IRA/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="cron_approval_escalate" model="ir.cron">
        <field name="name">Approvals: escalate overdue levels</field>
        <field name="model_id" ref="model_irio_approval_request"/>
        <field name="state">code</field>
        <field name="code">model._cron_escalate()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
