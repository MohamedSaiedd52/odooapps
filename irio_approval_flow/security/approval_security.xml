<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_irio_approvals" model="ir.module.category">
        <field name="name">Approvals (IRIO)</field>
        <field name="sequence">57</field>
    </record>

    <record id="privilege_irio_approvals" model="res.groups.privilege">
        <field name="name">Approvals (IRIO)</field>
        <field name="category_id" ref="module_category_irio_approvals"/>
    </record>

    <record id="group_approval_user" model="res.groups">
        <field name="name">User</field>
        <field name="privilege_id" ref="privilege_irio_approvals"/>
    </record>

    <record id="group_approval_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id" ref="privilege_irio_approvals"/>
        <field name="implied_ids" eval="[(4, ref('group_approval_user'))]"/>
    </record>

    <!-- system administrators manage approvals out of the box -->
    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_approval_manager'))]"/>
    </record>

    <!-- delegations: non-managers only see/edit their own -->
    <record id="rule_delegation_own" model="ir.rule">
        <field name="name">Approval Delegation: own</field>
        <field name="model_id" ref="model_irio_approval_delegation"/>
        <field name="domain_force">['|', ('user_id', '=', user.id), ('delegate_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="rule_delegation_manager" model="ir.rule">
        <field name="name">Approval Delegation: manager all</field>
        <field name="model_id" ref="model_irio_approval_delegation"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_approval_manager'))]"/>
    </record>

    <!-- multi-company -->
    <record id="rule_request_company" model="ir.rule">
        <field name="name">Approval Request: multi-company</field>
        <field name="model_id" ref="model_irio_approval_request"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_rule_company" model="ir.rule">
        <field name="name">Approval Rule: multi-company</field>
        <field name="model_id" ref="model_irio_approval_rule"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
