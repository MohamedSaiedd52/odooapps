<svg width="900" height="300" viewBox="0 0 900 300" xmlns="http://www.w3.org/2000/svg">
  <rect width="100%" height="100%" fill="black"/>
  <defs>
    <mask id="revealMask">
      <rect width="100%" height="100%" fill="black"/>
      <rect x="-100%" y="0" width="100%" height="100%" fill="white">
        <animate attributeName="x" from="-100%" to="0" dur="4s" repeatCount="indefinite"/>
      </rect>
    </mask>
  </defs>
  <text x="50%" y="50%" dy="10" font-family="Arial, Helvetica, sans-serif"
        font-weight="bold" font-size="36" text-anchor="middle"
        fill="#FFD700" mask="url(#revealMask)">
    Generate MO Draft from SO (MTO)
  </text>
</svg>
