<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data>

    <!-- Report Actions -->
    <record id="action_report_receipt_voucher" model="ir.actions.report">
        <field name="name">Receipt Voucher</field>
        <field name="model">ms.in</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">ms_cheque.report_receipt_voucher_template</field>
        <field name="report_file">ms_cheque.report_receipt_voucher_template</field>
        <field name="print_report_name">'Receipt - %s' % (object.name)</field>
        <field name="binding_model_id" ref="model_ms_in"/>
        <field name="binding_type">report</field>
    </record>

    <record id="action_report_payment_voucher" model="ir.actions.report">
        <field name="name">Payment Voucher</field>
        <field name="model">ms.out</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">ms_cheque.report_payment_voucher_template</field>
        <field name="report_file">ms_cheque.report_payment_voucher_template</field>
        <field name="print_report_name">'Payment - %s' % (object.name)</field>
        <field name="binding_model_id" ref="model_ms_out"/>
        <field name="binding_type">report</field>
    </record>

    <!-- Custom Personalized Layout -->
    <template id="voucher_custom_layout">
        <div class="header">
            <div class="row">
                <div class="col-12 mt-2">
                    <img t-if="env.company.logo"
                         t-att-src="image_data_uri(env.company.logo)"
                         style="margin:auto; max-height:120px; width:100%; object-fit: contain;"
                         alt="Logo" />
                </div>
            </div>
        </div>

        <div class="article o_report_layout_standard" 
             t-att-data-oe-model="o and o._name"
             t-att-data-oe-id="o and o.id" 
             t-att-data-oe-lang="o and o.env.context.get('lang')">
            <t t-out="0"/>
        </div>

        <div class="footer o_standard_footer">
            <div class="row mb-2" style="font-size: 11px;">
                <div class="col-4 text-center">
                    <strong>طبع بواسطة</strong>
                    <strong>:</strong>
                    <span t-esc="user.name"/>
                </div>
                <div class="col-4 text-center">
                    <strong>الصفحة</strong>
                    <strong>:</strong>
                    <span class="page"/>/
                    <span class="topage"/>
                </div>
                <div class="col-4 text-center">
                    <strong>زمن إستخراج التقرير</strong>
                    <strong>:</strong>
                    <span t-esc="context_timestamp(datetime.datetime.now()).strftime('%Y-%m-%d %H:%M')"/>
                </div>
            </div>

            <!-- Decorative Color bar -->
            <div class="row g-1 mb-2">
                <div class="col-7 bg-secondary" style="height:10px; background-color: #C0C0C0 !important;"></div>
                <div class="col-1" style="height:10px; background-color: #2E3192 !important;"></div>
                <div class="col-1" style="height:10px; background-color: #ED1C24 !important;"></div>
                <div class="col-1" style="height:10px; background-color: #FFF200 !important;"></div>
                <div class="col-2 bg-secondary" style="height:10px; background-color: #C0C0C0 !important;"></div>
            </div>

          
        </div>
    </template>



 <template id="report_receipt_voucher_template">
    <t t-call="web.html_container">
        <t t-foreach="docs" t-as="o">
    <t t-call="ms_cheque.voucher_custom_layout">
                <div class="page" style="font-family:Cairo; font-size:14px;">

                    <!-- SMALL HEADER -->
                    <table style="width:100%; border-collapse:collapse; margin-bottom:5px;" border="1">
                        <tr style="height:60px;">
                            <td style="width:15%; text-align:center;">
                                <img t-att-src="o.company_id.logo" style="max-height:55px;"/>
                            </td>
                            <td style="width:55%; text-align:center;">
                                <div style="font-size:18px; font-weight:bold;">سند قبض</div>
                                <div style="font-size:13px;">Receipt Voucher</div>
                            </td>
                            <td style="width:30%; text-align:center; font-size:14px;">
                                <div><strong>No:</strong> <span t-field="o.name"/></div>
                                <div><strong>Date:</strong> <span t-field="o.receive_date"/></div>
                            </td>
                        </tr>
                    </table>

                    <!-- AMOUNT BOX -->
                    <table style="width:100%; border-collapse:collapse; margin-bottom:10px;" border="1">
                        <tr>
                            <td style="text-align:center; font-size:18px; font-weight:bold;">
                                <span t-field="o.amount"
                                      t-options='{"widget":"monetary","display_currency":o.currency_id}'/>
                            </td>
                        </tr>
                    </table>

                    <!-- BODY -->
                    <table style="width:100%; border-collapse:collapse;" border="1">

                        <tr>
                            <td style="width:20%;"><strong>استلمنا من:</strong></td>
                            <td style="width:60%; text-align:center;">
                                <strong><t t-esc="o.payer_id.name"/></strong>
                            </td>
                            <td style="width:20%;"><strong>Received From</strong></td>
                        </tr>

                        <tr>
                            <td><strong>مبلغ وقدره:</strong></td>
                            <td style="text-align:center;">
                                <t t-esc="o.currency_id.amount_to_text(o.amount)"/>
                            </td>
                            <td><strong>The Sum Of</strong></td>
                        </tr>

                        <tr>
                            <td><strong>الحساب:</strong></td>
                            <td style="text-align:center;">
                                <t t-esc="o.debit_account_id.name"/>
                            </td>
                            <td><strong>Account</strong></td>
                        </tr>

                        <tr>
                            <td><strong>شيك رقم:</strong></td>
                            <td style="text-align:center;">
                                <t t-esc="o.cheque_no"/>
                            </td>
                            <td><strong>Cheque No</strong></td>
                        </tr>

                        <tr>
                            <td><strong>وذلك عن:</strong></td>
                            <td style="text-align:center;">
                                <span t-field="o.description"/>
                            </td>
                            <td><strong>For</strong></td>
                        </tr>

                    </table>

                    <!-- SIGNATURES -->
                    <table style="width:100%; margin-top:50px; border-collapse:collapse;">
                        <tr>
                            <td style="width:33%; text-align:center;">
                                .................................<br/>
                                <strong>المدير</strong><br/>Manager
                            </td>

                            <td style="width:33%; text-align:center;">
                                .................................<br/>
                                <strong>المحاسب</strong><br/>Accountant
                            </td>

                            <td style="width:33%; text-align:center;">
                                .................................<br/>
                                <strong>المستلم</strong><br/>Receiver
                            </td>
                        </tr>
                    </table>

                </div>
            </t>
        </t>
    </t>
</template>


<template id="report_payment_voucher_template">
    <t t-call="web.html_container">
        <t t-foreach="docs" t-as="o">
    <t t-call="ms_cheque.voucher_custom_layout">
