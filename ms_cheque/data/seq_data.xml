<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="seq_cheque_incoming" model="ir.sequence">
            <field name="name"> MS IN</field>
            <field name="code">seq.ch.in</field>
            <field name="prefix">INC/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_cheque_outgoing" model="ir.sequence">
            <field name="name">MS Out</field>
            <field name="code">seq.ch.out</field>
            <field name="prefix">OUT/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
