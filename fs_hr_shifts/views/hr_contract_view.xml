<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Attendance policy on the contract (from rm_hr_attendance_sheet) -->
    <record id="hr_contract_form" model="ir.ui.view">
        <field name="name">hr.contract.view</field>
        <field name="model">hr.contract</field>
        <field name="inherit_id" ref="hr_payroll.hr_contract_form_inherit"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='structure_type_id']" position="after">
                <field name="att_policy_id" required="1"/>
            </xpath>
        </field>
    </record>

    <!-- Multi shifts toggle (from fs_multi_shifts) -->
    <record id="hr_contract_view_form_inherit_multi_shifts" model="ir.ui.view">
        <field name="name">hr.contract.view.form.inherit.multi.shifts</field>
        <field name="model">hr.contract</field>
        <field name="inherit_id" ref="hr_contract.hr_contract_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='work_entry_source']" position="after">
                <field name="is_multi_shifts" widget="boolean_toggle"/>
            </xpath>
        </field>
    </record>

</odoo>
