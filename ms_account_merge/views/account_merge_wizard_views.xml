<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_ms_account_merge_wizard_form" model="ir.ui.view">
        <field name="name">ms.account.merge.wizard.form</field>
        <field name="model">ms.account.merge.wizard</field>
        <field name="arch" type="xml">
            <form string="Merge Accounts">
                <div class="alert alert-warning" role="alert">
                    All journal items and every reference (journals, taxes,
                    products, partners, ...) of the source accounts will be
                    moved to the destination account. The source accounts
                    will be archived. <b>This cannot be undone.</b>
                </div>
                <group>
                    <field name="account_ids"
                           widget="many2many_tags"
                           options="{'no_create': True}"/>
                    <field name="destination_account_id"
                           domain="[('id', 'in', account_ids)]"
                           options="{'no_create': True, 'no_open': True}"/>
                    <field name="allow_different_types"/>
                    <field name="line_count" readonly="1"/>
                </group>
                <footer>
                    <button name="action_merge"
                            string="Merge Accounts"
                            type="object"
                            class="btn-primary"
                            confirm="Are you sure? All movements will be transferred to the destination account and the source accounts will be archived. This action cannot be undone."/>
                    <button string="Cancel" class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_ms_account_merge_wizard" model="ir.actions.act_window">
        <field name="name">Merge Accounts</field>
        <field name="res_model">ms.account.merge.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="account.model_account_account"/>
        <field name="binding_view_types">list</field>
        <!-- The Accounting Administrator restriction is applied in the
             post_init_hook: the m2m on ir.actions.act_window is named
             groups_id up to Odoo 18 but group_ids since Odoo 19. -->
    </record>

</odoo>
