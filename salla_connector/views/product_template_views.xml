<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Server Action for Sync -->
    <record id="action_sync_salla_products" model="ir.actions.server">
        <field name="name">Sync from Salla</field>
        <field name="model_id" ref="product.model_product_template"/>
        <field name="binding_model_id" ref="product.model_product_template"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">
            action = model.action_sync_from_salla()
        </field>
    </record>

    <!-- Product Form Inherit -->
    <record id="product_template_form_view_inherit_salla" model="ir.ui.view">
        <field name="name">product.template.form.inherit.salla</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Salla" name="salla_info" invisible="not salla_product_id">
                    <group>
                        <group>
                            <field name="salla_product_id"/>
                            <field name="salla_url" widget="url"/>
                        </group>
                        <group>
                            <field name="salla_metadata"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
