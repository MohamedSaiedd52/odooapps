<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inherit Stock Picking Form View -->
    <record id="stock_picking_form_secondary_uom" model="ir.ui.view">
        <field name="name">stock.picking.form.secondary.uom</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <!-- Add secondary UoM fields to move lines (after product_uom) -->
            <xpath expr="//page[@name='operations']//field[@name='move_ids_without_package']/list//field[@name='product_uom'][last()]" position="after">
                <field name="secondary_uom_qty"
                       string="Sec. Demand"
                       optional="show"
                       invisible="not secondary_uom_id"
                       groups="uom.group_uom"/>
                <field name="secondary_quantity"
                       string="Sec. Done"
                       optional="show"
                       invisible="not secondary_uom_id"
                       groups="uom.group_uom"/>
                <field name="secondary_uom_id"
                       string="Sec. UoM"
                       optional="show"
                       invisible="not secondary_uom_id"
                       groups="uom.group_uom"/>
            </xpath>
        </field>
    </record>

    <!-- Inherit Stock Move List View -->
    <record id="stock_move_tree_secondary_uom" model="ir.ui.view">
        <field name="name">stock.move.tree.secondary.uom</field>
        <field name="model">stock.move</field>
        <field name="inherit_id" ref="stock.view_move_tree"/>
        <field name="arch" type="xml">
            <field name="product_uom" position="after">
                <field name="secondary_uom_qty"
                       string="Sec. Demand"
                       optional="show"
                       groups="uom.group_uom"/>
                <field name="secondary_quantity"
                       string="Sec. Done"
                       optional="show"
                       groups="uom.group_uom"/>
                <field name="secondary_uom_id"
                       string="Sec. UoM"
                       optional="show"
                       groups="uom.group_uom"/>
            </field>
        </field>
    </record>
</odoo>
