<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="account_move_form_secondary_uom" model="ir.ui.view">
        <field name="name">account.move.form.secondary.uom</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_line_ids']/list//field[@name='product_uom_id']" position="after">
                <field name="secondary_uom_qty"
                       string="Sec. Qty"
                       optional="show"
                       invisible="not secondary_uom_id"
                       groups="uom.group_uom"/>
                <field name="secondary_uom_id"
                       string="Sec. UoM"
                       optional="show"
                       invisible="not secondary_uom_id"
                       groups="uom.group_uom"/>
            </xpath>
        </field>
    </record>

    <record id="account_journal_items_tree_secondary_uom" model="ir.ui.view">
        <field name="name">account.move.line.tree.secondary.uom</field>
        <field name="model">account.move.line</field>
        <field name="inherit_id" ref="account.view_move_line_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_id']" position="after">
                <field name="secondary_uom_qty" string="Sec. Qty" optional="show"/>
                <field name="secondary_uom_id" string="Sec. UoM" optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>