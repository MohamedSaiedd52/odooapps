<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ms_view_account_form_analytic_policy" model="ir.ui.view">
        <field name="name">account.account.form.ms.analytic.policy</field>
        <field name="model">account.account</field>
        <field name="inherit_id" ref="account.view_account_form"/>
        <field name="arch" type="xml">
            <field name="account_type" position="after">
                <field name="ms_analytic_policy"
                       groups="analytic.group_analytic_accounting"/>
            </field>
        </field>
    </record>

    <record id="ms_view_account_list_analytic_policy" model="ir.ui.view">
        <field name="name">account.account.list.ms.analytic.policy</field>
        <field name="model">account.account</field>
        <field name="inherit_id" ref="account.view_account_list"/>
        <field name="arch" type="xml">
            <field name="account_type" position="after">
                <field name="ms_analytic_policy" optional="show"
                       groups="analytic.group_analytic_accounting"/>
            </field>
        </field>
    </record>
</odoo>
