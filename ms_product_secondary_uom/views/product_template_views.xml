<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_secondary_uom" model="ir.ui.view">
        <field name="name">product.template.form.secondary.uom</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//span[@name='uom_span']" position="after">
                <span groups="uom.group_uom" invisible="not secondary_uom_id">
                    / <field name="secondary_uom_id" class="oe_inline" style="max-width:136px" options="{'no_create': True}"/>
                </span>
            </xpath>

            <xpath expr="//field[@name='categ_id']" position="after">
                <field name="secondary_uom_id" groups="uom.group_uom" options="{'no_create': True}"/>
                <field name="conversion_factor" groups="uom.group_uom" invisible="not secondary_uom_id"/>
            </xpath>
        </field>
    </record>

    <record id="product_template_tree_secondary_uom" model="ir.ui.view">
        <field name="name">product.template.tree.secondary.uom</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_tree_view"/>
        <field name="arch" type="xml">
            <field name="uom_id" position="after">
                <field name="secondary_uom_id" optional="hide" groups="uom.group_uom"/>
                <field name="conversion_factor" optional="hide"/>
            </field>
        </field>
    </record>
</odoo>