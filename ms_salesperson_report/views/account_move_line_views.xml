<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ═══════════════════════════════════════════════════════════════
         إضافة فلتر "مندوب المبيعات" في Journal Items (قيود الحسابات)
         الموديل: account.move.line
         الحقل: move_id.invoice_user_id  (Many2one → res.users)
         ملاحظة: Odoo لا يدعم group_by بالـ dot notation على move.line
                 لذلك نكتفي بالفلاتر فقط
         ═══════════════════════════════════════════════════════════════ -->
    <record id="view_account_move_line_search_salesperson" model="ir.ui.view">
        <field name="name">account.move.line.search.salesperson</field>
        <field name="model">account.move.line</field>
        <field name="inherit_id" ref="account.view_account_move_line_filter"/>
        <field name="arch" type="xml">
            <!-- فلتر: مبيعاتي (أنا المندوب على الفاتورة) -->
            <xpath expr="//filter[@name='posted']" position="before">
                <filter
                    string="مبيعاتي (بالفاتورة)"
                    name="my_invoices_by_salesperson"
                    domain="[
                        ('move_id.invoice_user_id', '=', uid),
                        ('move_id.move_type', 'in', ['out_invoice', 'out_refund'])
                    ]"
                    help="عرض القيود المرتبطة بالفواتير التي أنا مندوبها"/>
                <separator/>
            </xpath>
        </field>
    </record>
</odoo>
