<odoo>
    <record id="view_import_transfer_message_wizard" model="ir.ui.view">
        <field name="name">import.transfer.message.wizard.form</field>
        <field name="model">import.transfer.message.wizard</field>
        <field name="arch" type="xml">
            <form string="Import Result">
                <group>
                    <field name="message" readonly="1"/>
                </group>
                <footer>
                    <button name="action_ok" type="object" string="OK" class="btn-primary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
