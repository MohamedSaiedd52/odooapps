<odoo>
    <data>
  <record id="view_import_internal_transfer_wizard_form" model="ir.ui.view">
      <field name="name">import.internal.transfer.wizard.form</field>
      <field name="model">import.internal.transfer.wizard</field>
      <field name="arch" type="xml">
        <form string="Import Internal Transfers (.xlsx)">
          <group>
            <field name="product_by"/>
            <field name="file"/>
            <field name="source_location_id"/>
            <field name="destination_location_id"/>
              <field name="picking_type_id"/>
          </group>
          <footer>
            <button name="import_internal_transfer_apply" string="Import" type="object" class="btn-primary"/>
            <button string="Cancel" class="btn-secondary" special="cancel"/>

                 <div style="float: right;">
                        <a role="button" href="/ms_import_internal_transfer/static/download/import_internal_transfer_excel.xlsx" class="btn-primary" style="font-size: 12px; line-height: 1.5; border-radius: 3px; padding: 8px 10px; color: #ffffff;">
                            <i class="fa fa-download" /> Excel file
                        </a>
                    </div>
          </footer>
        </form>
      </field>
    </record>

  <record id="action_import_internal_transfer_wizard" model="ir.actions.act_window">
    <field name="name">Import Internal Transfers</field>
    <field name="res_model">import.internal.transfer.wizard</field>
    <field name="view_mode">form</field>
    <field name="target">new</field>
  </record>

</data>
</odoo>

