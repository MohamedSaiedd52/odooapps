<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_shopify_product_tree" model="ir.ui.view">
        <field name="name">shopify.product.tree</field>
        <field name="model">shopify.product</field>
        <field name="type">tree</field>
        <field name="arch" type="xml">
            <tree string="Shopify Products" decoration-muted="not active" decoration-danger="sync_status == 'error'" decoration-warning="sync_status == 'pending'">
                <field name="name"/>
                <field name="shopify_product_id"/>
                <field name="shopify_sku"/>
                <field name="shopify_price" widget="monetary"/>
                <field name="shopify_inventory_quantity"/>
                <field name="odoo_product_id"/>
                <field name="instance_id"/>
                <field name="sync_status" widget="badge" decoration-success="sync_status == 'synced'" decoration-warning="sync_status == 'pending'" decoration-danger="sync_status == 'error'"/>
                <field name="last_sync"/>
                <field name="active" column_invisible="1"/>
            </tree>
        </field>
    </record>

    <record id="view_shopify_product_form" model="ir.ui.view">
        <field name="name">shopify.product.form</field>
        <field name="model">shopify.product</field>
        <field name="arch" type="xml">
            <form string="Shopify Product">
                <header>
                    <field name="sync_status" widget="statusbar" statusbar_visible="pending,synced,error"/>
                </header>
                <sheet>
                    <field name="shopify_image_url" widget="image_url" class="oe_avatar" options="{'size': [90, 90]}"/>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Product Name"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Shopify Information">
                            <field name="shopify_product_id"/>
                            <field name="shopify_variant_id"/>
                            <field name="shopify_handle"/>
                            <field name="shopify_status" widget="badge"/>
                            <field name="instance_id"/>
                        </group>
                        <group string="Odoo Information">
                            <field name="odoo_product_id"/>
                            <field name="last_sync"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group>
                        <group string="Pricing &amp; Inventory">
                            <field name="shopify_price"/>
                            <field name="shopify_sku"/>
                            <field name="shopify_inventory_quantity"/>
                        </group>
                        <group string="Product Details">
                            <field name="shopify_product_type"/>
                            <field name="shopify_vendor"/>
                            <field name="shopify_tags"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="body_html"/>
                        </page>
                        <page string="Notes">
                            <field name="note" placeholder="Internal notes..."/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_shopify_product_search" model="ir.ui.view">
        <field name="name">shopify.product.search</field>
        <field name="model">shopify.product</field>
        <field name="arch" type="xml">
            <search string="Shopify Products">
                <field name="name"/>
                <field name="shopify_product_id"/>
                <field name="shopify_sku"/>
                <field name="odoo_product_id"/>
                <field name="instance_id"/>
                <filter string="Synced" name="synced" domain="[('sync_status', '=', 'synced')]"/>
                <filter string="Pending" name="pending" domain="[('sync_status', '=', 'pending')]"/>
                <filter string="Error" name="error" domain="[('sync_status', '=', 'error')]"/>
                <filter string="Active" name="active" domain="[('active', '=', True)]"/>
                <separator/>
                <filter string="Has Variants" name="has_variants" domain="[('shopify_variant_id', '!=', False)]"/>
                <group>
                    <filter string="Instance" name="group_instance" context="{'group_by': 'instance_id'}"/>
                    <filter string="Status" name="group_status" context="{'group_by': 'sync_status'}"/>
                    <filter string="Vendor" name="group_vendor" context="{'group_by': 'shopify_vendor'}"/>
                    <filter string="Product Type" name="group_type" context="{'group_by': 'shopify_product_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_shopify_product" model="ir.actions.act_window">
        <field name="name">Shopify Products</field>
        <field name="res_model">shopify.product</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Shopify product mappings will appear here after sync.
            </p>
            <p>
                Click "Sync Products" on your Shopify Instance to import products.
            </p>
        </field>
    </record>
</odoo>