<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_loan_delay_wizard_view_form" model="ir.ui.view">
        <field name="name">hr.loan.delay.wizard.view.form</field>
        <field name="model">hr.loan.delay.wizard</field>
        <field name="arch" type="xml">
            <form string="Delay Installments">
                <group>
                    <field name="loan_id" readonly="1"/>
                    <field name="months"/>
                </group>
                <footer>
                    <button name="action_submit" type="object"
                            string="Submit" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_delay_installments_wizard" model="ir.actions.act_window">
        <field name="name">Delay Installments</field>
        <field name="res_model">hr.loan.delay.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
