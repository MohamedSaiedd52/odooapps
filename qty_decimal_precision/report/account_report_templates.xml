<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Invoice Report: limit quantity to 2 decimal places -->
    <template id="report_invoice_document_qty_precision"
              inherit_id="account.report_invoice_document">
        <xpath expr="//span[@t-field='line.quantity']" position="attributes">
            <attribute name="t-options">{"widget": "float", "precision": 2}</attribute>
        </xpath>
    </template>

</odoo>