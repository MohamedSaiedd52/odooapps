<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Purchase Order Report: limit quantity to 2 decimal places -->
    <template id="report_purchaseorder_document_qty_precision"
              inherit_id="purchase.report_purchaseorder_document">
        <xpath expr="//span[@t-field='line.product_qty']" position="attributes">
            <attribute name="t-options">{"widget": "float", "precision": 2}</attribute>
        </xpath>
    </template>

    <!-- Purchase Quotation Report: limit quantity to 2 decimal places -->
    <template id="report_purchasequotation_document_qty_precision"
              inherit_id="purchase.report_purchasequotation_document">
        <xpath expr="//span[@t-field='order_line.product_qty']" position="attributes">
            <attribute name="t-options">{"widget": "float", "precision": 2}</attribute>
        </xpath>
    </template>

</odoo>