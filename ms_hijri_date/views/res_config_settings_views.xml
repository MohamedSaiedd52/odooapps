<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.ms.hijri.date</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="90"/>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Hijri Dates" string="Hijri Dates" name="ms_hijri_date"
                     logo="/ms_hijri_date/static/description/icon.png">
                    <block title="Hijri Display" name="ms_hijri_display_block">
                        <setting id="ms_hijri_format_setting" string="Display Format"
                                 help="How Hijri dates are rendered on forms and PDF reports.">
                            <field name="hijri_format" class="o_light_label"/>
                        </setting>
                        <setting id="ms_hijri_adjustment_setting" string="Moon-sighting Adjustment"
                                 help="Shift the computed Hijri date by up to 3 days either way to match local moon sighting or the Umm al-Qura calendar.">
                            <field name="hijri_adjustment"/>
                        </setting>
                        <setting id="ms_hijri_today_setting" string="Today in Hijri"
                                 help="Live preview using the current format and adjustment.">
                            <field name="hijri_today" readonly="1" class="fw-bold"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
