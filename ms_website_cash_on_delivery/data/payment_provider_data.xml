<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="payment_provider_cod" model="payment.provider">
        <field name="name">Cash on Delivery</field>
        <field name="code">custom</field>
        <field name="custom_mode">cash_on_delivery</field>
        <field name="state">disabled</field>
        <field name="is_published" eval="False"/>
        <field name="redirect_form_view_id" ref="payment_custom.redirect_form"/>
        <field name="payment_method_ids"
               eval="[Command.set([ref('payment_method_cash_on_delivery')])]"/>
        <field name="image_128" type="base64" file="ms_website_cash_on_delivery/static/img/cod.png"/>
        <field name="pending_msg" type="html">
            <p>Your order is confirmed and will be paid in cash on delivery.
               Please keep the exact amount ready for the courier.</p>
        </field>
    </record>

</odoo>
