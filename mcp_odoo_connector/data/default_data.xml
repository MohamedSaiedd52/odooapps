<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <!-- System Parameters: Default Configuration -->
    <function model="ir.config_parameter" name="set_param" eval="('mcp_odoo_connector.enabled', 'False')"/>
    <function model="ir.config_parameter" name="set_param" eval="('mcp_odoo_connector.logging_enabled', 'True')"/>
    <function model="ir.config_parameter" name="set_param" eval="('mcp_odoo_connector.rate_limit', '10')"/>
    <function model="ir.config_parameter" name="set_param" eval="('mcp_odoo_connector.log_retention_days', '90')"/>
    <function model="ir.config_parameter" name="set_param" eval="('mcp_odoo_connector.max_records_per_request', '1000')"/>
    <function model="ir.config_parameter" name="set_param" eval="('mcp_odoo_connector.cache_enabled', 'False')"/>
    <function model="ir.config_parameter" name="set_param" eval="('mcp_odoo_connector.default_cache_ttl', '300')"/>
    <function model="ir.config_parameter" name="set_param" eval="('mcp_odoo_connector.yolo_mode', 'disabled')"/>
    <function model="ir.config_parameter" name="set_param" eval="('mcp_odoo_connector.allowed_ips', '')"/>

    <!-- Cron Job: Cleanup old audit logs -->
    <record id="cron_mcp_audit_log_cleanup" model="ir.cron">
        <field name="name">MCP Server: Cleanup Old Audit Logs</field>
        <field name="model_id" ref="model_mcp_audit_log"/>
        <field name="state">code</field>
        <field name="code">model._cron_cleanup_old_logs()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active">True</field>
    </record>

</odoo>
