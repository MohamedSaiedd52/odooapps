<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Tree View -->
    <record id="mcp_chat_session_view_tree" model="ir.ui.view">
        <field name="name">mcp.chat.session.tree</field>
        <field name="model">mcp.chat.session</field>
        <field name="arch" type="xml">
            <tree string="AI Chat Sessions">
                <field name="name"/>
                <field name="user_id"/>
                <field name="create_date"/>
            </tree>
        </field>
    </record>

    <!-- Form View -->
    <record id="mcp_chat_session_view_form" model="ir.ui.view">
        <field name="name">mcp.chat.session.form</field>
        <field name="model">mcp.chat.session</field>
        <field name="arch" type="xml">
            <form string="AI Chat Session">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="user_id" readonly="1"/>
                    </group>

                    <group string="Chat">
                        <field name="user_input" placeholder="Type your message to the AI here..."/>
                        <button name="action_send"
                                type="object"
                                string="Send"
                                class="btn-primary mt-2"/>
                    </group>

                    <notebook>
                        <page string="Messages">
                            <field name="message_ids">
                                <tree string="Messages" editable="false">
                                    <field name="create_date"/>
                                    <field name="role"/>
                                    <field name="content"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_mcp_chat_session" model="ir.actions.act_window">
        <field name="name">AI Chat</field>
        <field name="res_model">mcp.chat.session</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Start a conversation with your AI assistant inside Odoo.
            </p>
            <p>
                Configure the AI provider under Settings &gt; MCP Server, then create a
                new chat session and start messaging.
            </p>
        </field>
    </record>

</odoo>

