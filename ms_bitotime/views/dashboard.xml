<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <!-- Client Action -->
        <record id="ms_bitotime_action" model="ir.actions.client">
            <field name="name">Biotime Dashboard</field>
            <field name="tag">ms_bitotime_tag</field>
        </record>

    <record id="action_hr_attendance_overview" model="ir.actions.act_window">
        <field name="name">Attendance</field>
        <field name="res_model">hr.attendance</field>
        <field name="view_mode">list,form,pivot</field>
    </record>

    <!-- Menu -->
    <menuitem id="menu_hr_attendance_overview"
              name="Attendance"
              parent="ms_biotime_root_menu"
              action="action_hr_attendance_overview"
              sequence="3"/>
        <!-- Menu Item -->
        <menuitem id="menu_ms_bitotime"
                  name="Dashboard"
                  parent="ms_biotime_root_menu"
                  action="ms_bitotime_action"
                  sequence="1"/>
    </data>
</odoo>
