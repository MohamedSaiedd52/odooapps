<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data noupdate="1">
        <!-- Dedicated queue_job channel: one BioTime pull at a time -->
        <record id="channel_biotime" model="queue.job.channel">
            <field name="name">biotime</field>
            <field name="parent_id" ref="channel_root"/>
        </record>

        <!-- Route the pull job to the biotime channel, retry on failure -->
        <record id="job_function_biotime_pull" model="queue.job.function">
            <field name="model_id" ref="ms_bitotime.model_biotime_config"/>
            <field name="method">_job_pull_yesterday_transactions</field>
            <field name="channel_id" ref="channel_biotime"/>
            <field name="retry_pattern" eval="{1: 60, 2: 300, 3: 600, 4: 1800}"/>
        </record>
    </data>
</odoo>
