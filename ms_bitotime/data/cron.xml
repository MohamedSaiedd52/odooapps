<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data noupdate="1">
        <!-- Runs daily at 01:00 UTC = 03:00 Africa/Tripoli; enqueues one queue_job per server -->
        <record id="ir_cron_biotime_pull_yesterday" model="ir.cron">
            <field name="name">BioTime: Pull Yesterday Transactions (queued)</field>
            <field name="model_id" ref="ms_bitotime.model_biotime_config"/>
            <field name="state">code</field>
            <field name="code">model.cron_pull_yesterday_transactions()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active">True</field>
            <field name="nextcall" eval="(DateTime.now() + timedelta(days=1)).strftime('%Y-%m-%d 01:00:00')"/>
        </record>
    </data>
</odoo>
